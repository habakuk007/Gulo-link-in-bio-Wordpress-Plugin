root = true

# WordPress uses tabs for indentation in PHP, JS, and CSS.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{php,js,css,scss,json,yml,yaml,xml}]
indent_style = tab
indent_size = 4

# Markdown — preserve trailing spaces (they mean <br>).
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2
