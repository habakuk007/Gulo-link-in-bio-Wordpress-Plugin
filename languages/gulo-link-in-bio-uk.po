#. Description of the plugin
#: gulo-link-in-bio.php
msgid "A link-in-bio page for WordPress — a self-hosted alternative to Linktree. Configure your profile in the Gulo Link-in-Bio admin menu, then assign the page template to any Page."
msgstr "Сторінка link-in-bio для WordPress — самостійна альтернатива Linktree. Налаштуйте свій профіль у меню адміністратора Gulo Link-in-Bio, а потім призначте шаблон сторінки будь-якій сторінці."

#. Author of the plugin
#: gulo-link-in-bio.php
msgid "Stefan Wagner"
msgstr ""

