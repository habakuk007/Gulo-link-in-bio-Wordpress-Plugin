#. Description of the plugin
#: link-in-bio.php
msgid "A link-in-bio page for WordPress — a self-hosted alternative to Linktree. Configure your profile in the Link in Bio admin menu, then assign the page template to any Page."
msgstr "Сторінка link-in-bio для WordPress — самостійна альтернатива Linktree. Налаштуйте свій профіль у меню адміністратора Link in Bio, а потім призначте шаблон сторінки будь-якій сторінці."

#. Author of the plugin
#: link-in-bio.php
msgid "Stefan Wagner"
msgstr ""

#: includes/class-lib-admin.php:46
msgid "Link in Bio Settings"
msgstr "Налаштування Link in Bio"

#: includes/class-lib-admin.php:115
msgid "Select Profile Image"
msgstr "Вибрати зображення профілю"

#: includes/class-lib-admin.php:116
