msgid "https://github.com/habakuk007/Wordpress-LinkInBio-Template"
msgstr ""

#. Description of the plugin
#: simple-bio-links.php
msgid "A link-in-bio page for WordPress — a self-hosted alternative to Linktree. Configure your profile in the Gulo Link-in-Bio admin menu, then assign the page template to any Page."
msgstr "Une page link-in-bio pour WordPress — une alternative auto-hébergée à Linktree. Configurez votre profil dans le menu d'administration Gulo Link-in-Bio, puis assignez le modèle de page à n'importe quelle page."

#. Author of the plugin
#: simple-bio-links.php
msgid "Stefan Wagner"
msgstr ""

