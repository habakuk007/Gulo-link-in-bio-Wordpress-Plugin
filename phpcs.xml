<?xml version="1.0"?>
<ruleset name="Gulo Link-in-Bio WPCS">
	<description>WordPress Coding Standards for the Gulo Link-in-Bio plugin.</description>

	<file>.</file>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>tests/bootstrap.php</exclude-pattern>
	<exclude-pattern>bin/*</exclude-pattern>
	<!-- JS/CSS are linted by ESLint and Stylelint respectively. -->
	<exclude-pattern>assets/js/*</exclude-pattern>
	<exclude-pattern>assets/css/*</exclude-pattern>

	<!-- WordPress core rules -->
	<rule ref="WordPress"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress-Extra"/>

	<!-- PHP 7.4+ compatibility -->
	<rule ref="PHPCompatibility"/>
	<config name="testVersion" value="7.4-"/>

	<!-- Text domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="gulo-link-in-bio"/>
			</property>
		</properties>
	</rule>

	<!-- Custom capabilities registered by this plugin -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="guloli_manage_settings"/>
			</property>
		</properties>
	</rule>

	<!-- Allowed namespaced hooks (plugin prefix) -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="guloli_"/>
				<element value="guloli_"/>
			</property>
		</properties>
	</rule>

	<!-- Line length: allow longer lines in templates and inline HTML -->
	<rule ref="Generic.Files.LineLength">
		<properties>
			<property name="lineLimit" value="200"/>
			<property name="absoluteLineLimit" value="200"/>
		</properties>
	</rule>
</ruleset>
